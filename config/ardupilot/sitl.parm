# Paramètres spécifiques au SITL : remplacent le matériel réel par ses équivalents simulés.
# Chargé après pixhawk.param (les valeurs ici l'emportent). N'y mettre que ce qui ne peut pas valoir
# pour le vrai drone : tout autre réglage se fait dans pixhawk.param, pour la Pixhawk et la simu à la fois.

# --- Moteurs : plugin ArduPilot de Gazebo (modèle iris), PWM sur les sorties 1-4 ---
# (vrai drone : DShot300 bidirectionnel sur SERVO9-12)
MOT_PWM_TYPE     0      # PWM normal
MOT_PWM_MIN      1100
MOT_PWM_MAX      1900
SERVO1_FUNCTION  33     # moteurs 1 à 4
SERVO2_FUNCTION  34
SERVO3_FUNCTION  35
SERVO4_FUNCTION  36
SERVO9_FUNCTION  0
SERVO10_FUNCTION 0
SERVO11_FUNCTION 0
SERVO12_FUNCTION 0
INS_HNTCH_ENABLE 0      # notch sur le régime des ESC : pas de télémétrie DShot en simu

# --- Capteurs : calibrations de la vraie Pixhawk, qui fausseraient les capteurs simulés ---
# Valeurs de copter.parm (défauts du SITL) : offsets du compas simulé, et petits offsets d'accéléromètre
# sans lesquels le SITL se croit non calibré. Identifiants : le SITL déclare les siens (eeprom effacée par -w).
COMPASS_PRIO1_ID 0
COMPASS_PRIO2_ID 0
COMPASS_ORIENT   0      # vrai drone : compas du M8N tourné de 270°
COMPASS_OFS_X    5
COMPASS_OFS_Y    13
COMPASS_OFS_Z    -18
COMPASS_DIA_X    1
COMPASS_DIA_Y    1
COMPASS_DIA_Z    1
COMPASS_ODI_X    0
COMPASS_ODI_Y    0
COMPASS_ODI_Z    0
INS_ACCOFFS_X    0.001
INS_ACCOFFS_Y    0.001
INS_ACCOFFS_Z    0.001
INS_ACCSCAL_X    1.001
INS_ACCSCAL_Y    1.001
INS_ACCSCAL_Z    1.001
INS_ACC2OFFS_X   0.001
INS_ACC2OFFS_Y   0.001
INS_ACC2OFFS_Z   0.001
INS_ACC2SCAL_X   1.001
INS_ACC2SCAL_Y   1.001
INS_ACC2SCAL_Z   1.001
AHRS_TRIM_X      0
AHRS_TRIM_Y      0

# --- Carte : batterie et bouton de sécurité simulés par le SITL ---
BATT_MONITOR     4      # tension et courant analogiques simulés (vrai drone : capteur I2C)
BRD_SAFETY_DEFLT 0      # pas de bouton de sécurité en simu

# --- Liaison MAVROS : SERIAL1 en SITL (MAV2), SERIAL4 (MAV4, aucun flux par défaut) sur le drone ---
# MAV2 porte en vrai les flux de la télémétrie ELRS : remis à 0 pour que la simu ne reçoive, comme la Pi,
# que les messages demandés par set_message_interval
MAV2_ADSB        0
MAV2_EXT_STAT    0
MAV2_EXTRA1      0
MAV2_EXTRA2      0
MAV2_EXTRA3      0
MAV2_PARAMS      0
MAV2_POSITION    0
MAV2_RAW_CTRL    0
MAV2_RAW_SENS    0
MAV2_RC_CHAN     0

# --- MTF-01 simulé, transmis à l'autopilote comme sur le drone (et non à ROS) ---
# flux optique calculé par le SITL, lidar = capteur Gazebo envoyé par le plugin ArduPilot (rng_1)
SIM_FLOW_ENABLE  1
FLOW_TYPE        10     # SITL
FLOW_FXSCALER    0      # calibration du vrai capteur
FLOW_FYSCALER    0
RNGFND1_TYPE     100    # SITL
RNGFND1_GNDCLR   0.15   # m : distance lue drone posé dans Gazebo (0,145 m)
