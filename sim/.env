# Variables lues par docker compose (et passées aux Dockerfiles).
# Pour une config perso, ne pas modifier ce fichier : exporter la variable dans le shell.

# Version d'ArduPilot du SITL : doit être celle flashée sur la Pixhawk
# (visible dans QGroundControl / Mission Planner à la connexion).
ARDUPILOT_TAG=Copter-4.7.2

# Isolation quand plusieurs personnes lancent la simu sur la même machine :
# chacun prend un ROS_DOMAIN_ID et un GZ_PARTITION différents (et un -p <projet> différent).
ROS_DOMAIN_ID=0
GZ_PARTITION=droneload
