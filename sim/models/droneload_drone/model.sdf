<?xml version="1.0"?>
<!--
  Drone DroneLoad simulé, dérivé de iris_with_ardupilot (ardupilot_gazebo, commit 80dc966) :
  châssis iris, aérodynamique des hélices et plugin ArduPilot (liaison SITL) en sont repris tels quels.
  Vrai drone : châssis F450 en X, moteurs 2216 920 KV, hélices 1045. TODO : géométrie, masse,
  inerties et poussée sont encore celles de l'iris, à recaler quand le drone sera pesé.
  Ajouts DroneLoad (positions provisoires) :
  - lidar du MTF-01 vers le bas, envoyé au SITL par le plugin ArduPilot (le flux optique est simulé par le SITL) ;
  - caméra Module 3 (66° H, 640x480 @ 15 Hz), fixe vers le sol ;
  - caméra de profondeur USB type RealSense D435 (87° H, 0,28-10 m), fixe vers l'avant.
-->
<sdf version="1.9">
  <model name="droneload_drone">
    <include>
      <uri>model://iris_with_standoffs</uri>
    </include>

    <!--
      visual markers for debugging
      - blade root    - teal
      - blade tip     - orange
      - blade cp      - yellow
      - blade forward - red
      - blade upward  - blue
    -->
