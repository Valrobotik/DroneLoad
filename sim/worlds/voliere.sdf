<?xml version="1.0" ?>
<!--
  Volière DroneLoad, terrain du règlement 2027 (figure 1).
  FICHIER GÉNÉRÉ par sim/tools/generate_voliere.py : modifier les cotes du script et régénérer.
  Terrain de jeu 8 x 5 m (rouge dedans, blanc dehors) ; zone A de départ (ArUco 0) ;
  zone B : fenêtre E (ouverture 1 x 1 m, ArUco 4-7 au recto, 8-9 au verso), obstacles F, passage sûr D
  (lignes verte et jaune) ; zone C : affiches de livraison 1-4, robot (ArUco 1 dessus), cache visuel,
  ArUco d'alignement 2 et 3.
  ArUco : carré noir de 20 cm (marker_size de drone.yaml) ; la texture a une marge blanche de 1/12
  de chaque côté, d'où des boîtes de 24 cm.
  Repère : origine au centre du terrain, x de la zone A vers la zone C (avant du drone au départ),
  z vers le haut ; poste de pilotage derrière la zone A, sa droite est -y.
-->
<sdf version="1.9">
  <world name="voliere">
    <!-- Pas de 1 ms, synchronisé avec le SITL (lock-step du plugin ArduPilot) -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.8 0.8 0.8 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drone posé sur l'ArUco 0, face à la zone C (même pose dans sim/scripts/reset_drone.sh) -->
    <include>
      <uri>model://droneload_drone</uri>
      <name>drone</name>
      <pose>-3.45 -1.25 0.195 0 0 0</pose>
    </include>

    <model name="marquages_sol">
      <static>true</static>
      <link name="link">
        <visual name="rouge_gauche"><pose>0 2.475 0.003 0 0 0</pose><geometry><box><size>7.95 0.05 0.002</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <visual name="rouge_droite"><pose>0 -2.475 0.003 0 0 0</pose><geometry><box><size>7.95 0.05 0.002</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
        <visual name="rouge_fond"><pose>3.975 0 0.003 0 0 1.571</pose><geometry><box><size>4.95 0.05 0.002</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
