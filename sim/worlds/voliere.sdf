        <visual name="bc_blanc"><pose>0.925 0 0.003 0 0 1.571</pose><geometry><box><size>5 0.05 0.002</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="bc_bleu"><pose>0.975 0 0.003 0 0 1.571</pose><geometry><box><size>5 0.05 0.002</size></box></geometry><material><ambient>0 0.3 1 1</ambient><diffuse>0 0.3 1 1</diffuse></material></visual>
        <visual name="affiche_1"><pose>3.52 -1.875 0.003 0 0 0</pose><geometry><box><size>0.297 0.42 0.002</size></box></geometry><material><ambient>0.11 0.62 0.46 1</ambient><diffuse>0.11 0.62 0.46 1</diffuse><emissive>0.11 0.62 0.46 1</emissive></material></visual>
        <visual name="affiche_3"><pose>3.52 -0.625 0.003 0 0 0</pose><geometry><box><size>0.297 0.42 0.002</size></box></geometry><material><ambient>0.85 0.35 0.19 1</ambient><diffuse>0.85 0.35 0.19 1</diffuse><emissive>0.85 0.35 0.19 1</emissive></material></visual>
        <visual name="affiche_2"><pose>3.52 0.625 0.003 0 0 0</pose><geometry><box><size>0.297 0.42 0.002</size></box></geometry><material><ambient>0.83 0.33 0.49 1</ambient><diffuse>0.83 0.33 0.49 1</diffuse><emissive>0.83 0.33 0.49 1</emissive></material></visual>
