        <visual name="aruco_3"><pose>2.72 1.08 0.012 0 0 0</pose><geometry><box><size>0.24 0.24 0.001</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><emissive>1 1 1 1</emissive><pbr><metal><albedo_map>model://aruco_markers/materials/textures/aruco_3.png</albedo_map><emissive_map>model://aruco_markers/materials/textures/aruco_3.png</emissive_map></metal></pbr></material></visual>
      </link>
    </model>

